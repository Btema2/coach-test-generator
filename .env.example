GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-pro
BATCH_SIZE=10

# ── Web app (serve.py) ──
# Name shown in the header, page titles and emails.
BRAND_NAME=Coach Exam Prep
# Database for accounts and results. Leave empty for a local SQLite file
# (data/app.db). On hosts with a temporary disk (e.g. Render's free tier),
# use a hosted Postgres URL so results survive restarts.
DATABASE_URL=
# Signs session cookies. If empty, one is generated and kept in the database.
SECRET_KEY=
# Password for the answer key at /admin. If empty, /admin is switched off.
ADMIN_PASSWORD=
# Shown in the footer and on the privacy page.
CONTACT_EMAIL=

# Sign-in emails. Without email settings, `python serve.py` prints sign-in links to
# the terminal; under gunicorn, signing in is switched off and guests are not limited.
# MAIL_FROM is the sender, e.g. "Coach Exam Prep <you@example.com>".
MAIL_FROM=
# Brevo's HTTPS API (free: 300 emails/day). Use this on Render's free plan, which
# blocks SMTP ports. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
# Or plain SMTP (ignored when BREVO_API_KEY is set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Public address used in sign-in links (Render sets RENDER_EXTERNAL_URL itself).
PUBLIC_URL=
# Exams a guest can finish before being asked to sign in (-1 = no limit).
GUEST_FREE_EXAMS=1
